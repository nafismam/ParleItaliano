# Copy to .env for Docker Compose. Never commit real secrets.
# Generate locally: openssl rand -base64 48
AUTH_SECRET=
APP_ORIGIN=http://localhost:3000
AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/parle?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
# Set true only behind a proxy that replaces X-Forwarded-For, not one that appends untrusted input.
TRUST_PROXY=false
# Optional Google OAuth; callback: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Hosted alternative to REDIS_URL: set both Upstash bindings and omit REDIS_URL.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
